<!-- main.fxml -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Font?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.image.Image?>
<BorderPane fx:id="painelRaiz"
            fx:controller="com.gustavo.mainapp.controller.MainController"
            xmlns:fx="http://javafx.com/fxml"
            stylesheets="@styles.css">

    <top>
        <ToolBar>
            <Button text="Abrir" onAction="#importarSessoes"/>
            <Separator/>
            <Button text="Ordenar por horário" onAction="#ordenarPorHorario"/>
            <Button text="Filtrar hoje" onAction="#filtrarHoje"/>
            <Button text="Mostrar todas" onAction="#mostrarTodas"/>
        </ToolBar>
    </top>

    <left>
        <ListView fx:id="listaSessoes" prefWidth="220"/>
    </left>

    <center>
        <GridPane hgap="10" vgap="10" alignment="CENTER">
            <padding>
                <Insets top="10" bottom="10" left="10" right="10"/>
            </padding>

            <Label text="Sessões de hoje"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="0"
                   GridPane.columnSpan="2"
                   GridPane.halignment="CENTER"/>

            <StackPane GridPane.rowIndex="1" GridPane.columnIndex="0">

                <ImageView fx:id="cartazFilme"
                           fitWidth="140"
                           fitHeight="220"
                           onMouseEntered="#ampliarCartaz"
                           onMouseExited="#restaurarCartaz"/>

                <Label text="ESGOTADO"
                       style="-fx-background-color: rgba(0,0,0,0.6); -fx-text-fill: white;"/>

            </StackPane>

            <VBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="1">
                <Label fx:id="labelSessaoSelecionada"
                       text="Sessão selecionada"
                       wrapText="true"
                       textFill="#B45309">
                    <font>
                        <Font name="Arial Bold" size="16"/>
                    </font>
                </Label>

                <TextArea fx:id="areaDetalhes"
                          editable="false"
                          wrapText="true"
                          prefRowCount="4"/>

                <TextField fx:id="campoNomeCliente"
                           promptText="Nome do cliente"/>

                <ComboBox fx:id="comboSala" promptText="Escolha a sala">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Sala 1"/>
                            <String fx:value="Sala 2"/>
                            <String fx:value="Sala 3 — IMAX"/>
                        </FXCollections>
                    </items>
                    <value><String fx:value="Sala 1"/></value>
                </ComboBox>

                <fx:define>
                    <ToggleGroup fx:id="grupoAssento"/>
                </fx:define>
                <RadioButton text="Plateia" toggleGroup="$grupoAssento" selected="true"/>
                <RadioButton text="Balcão" toggleGroup="$grupoAssento"/>
                <RadioButton text="VIP" toggleGroup="$grupoAssento"/>

                <VBox spacing="6">
                    <CheckBox text="Pipoca grande"/>
                    <CheckBox text="Refrigerante"/>
                    <CheckBox text="Óculos 3D"/>
                </VBox>

                <HBox spacing="10" alignment="BOTTOM_RIGHT">
                    <padding><Insets bottom="10" right="10"/></padding>
                    <Button fx:id="botaoReservar"
                            text="Reservar bilhete"
                            prefWidth="140"
                            onAction="#reservarBilhete">
                        <graphic>
                            <ImageView>
                                <Image url="@icones/ticket.png"/>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button fx:id="botaoCancelar"
                            id="botaoCancelar"
                            text="Cancelar"
                            prefWidth="90"/>
                </HBox>

                <TitledPane text="Política de cancelamento" expanded="false">
                    <Label text="Reservas podem ser canceladas até 2 horas antes da sessão."
                           wrapText="true"/>
                </TitledPane>

                <Accordion>
                    <panes>
                        <TitledPane fx:id="painelPagamento" text="Formas de pagamento">
                            <Label text="Aceitamos cartão e Multibanco." wrapText="true"/>
                        </TitledPane>
                        <TitledPane text="Trocas e devoluções">
                            <Label text="Bilhetes não são reembolsáveis após o início da sessão."
                                   wrapText="true"/>
                        </TitledPane>
                    </panes>
                </Accordion>
            </VBox>
        </GridPane>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="CineTicket v1.0"/>
            <Label fx:id="labelStatus" text=""/>
        </HBox>
    </bottom>
</BorderPane>